<h1 class="h3"><%= workspace.name %></h1>
<p class="text-muted"><%= workspace.description %></p>

<div class="row g-3 mt-1">
  <div class="col-md-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Files</h2>
      <p>Upload and manage workspace files in OpenAI storage.</p>
      <a href="/workspaces/<%= workspace._id %>/chatbot/files" class="btn btn-outline-primary btn-sm">Manage files</a>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Knowledge</h2>
      <p>Create markdown knowledge and publish it to the vector store.</p>
      <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge" class="btn btn-outline-primary btn-sm">Manage knowledge</a>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Chatbot</h2>
      <p>Edit widget settings, allowed domains, and embed snippet.</p>
      <a href="/workspaces/<%= workspace._id %>/chatbot" class="btn btn-outline-primary btn-sm">Manage chatbot</a>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Analytics</h2>
      <p>Track visits, link interactions, and engagement metrics.</p>
      <a href="/workspaces/<%= workspace._id %>/analytics" class="btn btn-outline-primary btn-sm">View analytics</a>
    </div></div>
  </div>
</div>

<div class="alert alert-secondary mt-4">
  <strong>Vector Store ID:</strong> <code><%= workspace.openaiVectorStoreId %></code>
</div>
