<%- include('../partials/tabLinks', { workspace, activeTab: 'submissions', tabLinks }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="m-0">Feedback submissions</h4>
  <a href="/workspaces/<%= workspace._id %>/feedback/confirmation" class="btn btn-outline-secondary btn-sm">Preview confirmation</a>
</div>

<%
  const columns = [
    { key: 'createdAt', label: 'Submitted at', sortType: 'date' },
    { key: 'pageUrl', label: 'Page', sortType: 'string' },
    { key: 'responses', label: 'Responses', sortable: false },
  ];

  const rows = submissions.map((item) => {
    const entries = Object.entries(item.payload || {});
    return {
      href: `/workspaces/${workspace._id}/feedback/submissions/${item.id}`,
      values: {
        id: item.id,
        createdAt: item.createdAt,
        pageUrl: item.pageUrl || '',
      },
      cells: {
        createdAt: item.createdAt,
        pageUrl: item.pageUrl || '—',
        responses: entries.length
          ? entries
              .map(([key, value]) => `<div><strong>${key}:</strong> ${Array.isArray(value) ? value.join(', ') : value}</div>`)
              .join('')
          : '<span class="text-muted">—</span>',
      }
    };
  });
%>

<%- include('../partials/bootstrapTableWidget', {
  tableId: 'feedback-submissions-table',
  columns,
  rows,
  defaultPageSize: 20,
  selectableRows: true,
  selectionValueKey: 'id',
  bulkActions: {
    delete: {
      action: `/workspaces/${workspace._id}/feedback/submissions/bulk-delete`,
      method: 'POST',
      inputName: 'ids',
      confirmMessage: 'Delete selected submissions?'
    }
  }
}) %>
