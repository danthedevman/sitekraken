<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="m-0">Feedback confirmation preview</h4>
  <a href="/workspaces/<%= workspace._id %>/feedback" class="btn btn-outline-secondary btn-sm">Back to form settings</a>
</div>

<div class="card">
  <div class="card-body">
    <h5><%= feedback?.config?.confirmationTitle || 'Thanks for your feedback' %></h5>
    <p class="text-muted mb-0"><%= feedback?.config?.confirmationMessage || 'Your response has been submitted.' %></p>
  </div>
</div>
