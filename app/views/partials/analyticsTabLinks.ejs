<%
  const tabs = [
    { key: 'dashboard', label: 'Dashboard', href: `/workspaces/${workspace._id}/analytics/dashboard` },
    { key: 'installation', label: 'Installation', href: `/workspaces/${workspace._id}/analytics/installation` }
  ];
%>

<ul class="nav nav-pills mb-3">
  <% tabs.forEach(tab => { %>
    <li class="nav-item" role="presentation">
      <a
        href="<%= tab.href %>"
        class="nav-link <%= analyticsTab === tab.key ? 'active' : '' %>">
        <%= tab.label %>
      </a>
    </li>
  <% }) %>
</ul>
