<%if(typeof tabs !== "undefined" && tabs){%>
<ul class="nav nav-tabs mb-4">
  <% tabs.forEach(tab => { %>
  <li class="nav-item" role="presentation">
    <a href="<%= tab.href %>" class="nav-link <%= activeTab === tab.key ? 'active' : '' %>">
      <%= tab.label %>
    </a>
  </li>
  <% }) %>
</ul>

<%}%>