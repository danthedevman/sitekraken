<%
  const hasWorkspaceContext = typeof workspace !== 'undefined' && workspace;
  const isWorkspacesIndex = currentPath === '/workspaces';
  const containerClass = isWorkspacesIndex || hasWorkspaceContext ? 'container-fluid px-2' : 'container';
%>

<nav class="navbar navbar-expand-lg bg-body-tertiary<%= hasWorkspaceContext ? ' with-sidebar' : '' %>">
  <div class="<%= containerClass %> d-flex align-items-center w-100 gap-3">
    <% if (!hasWorkspaceContext) { %>
      <a class="navbar-brand fw-bold" href="/">SiteKraken</a>
    <% } %>

    <div class="collapse navbar-collapse show justify-content-between">
      <% if (!hasWorkspaceContext) { %>
        <ul class="navbar-nav mb-2 mb-lg-0">
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link" href="/workspaces">Workspaces</a></li>
          <% } %>
        </ul>
      <% } else { %>
        <div class="dropdown">
          <button
            class="btn btn-outline-secondary d-flex align-items-center btn-sm dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="<%= workspace.name %>">
            <span class="d-inline-block text-truncate" style="max-width: 220px;"><%= workspace.name %></span>
          </button>
          <ul class="dropdown-menu shadow-sm">
            <% const recent = Array.isArray(recentWorkspaces) ? recentWorkspaces.slice(0, 5) : []; %>
            <% if (recent.length > 0) { %>
              <% recent.forEach((item) => { %>
                <li>
                  <a
                    class="dropdown-item <%= String(item.id) === String(workspace._id) ? 'active' : '' %>"
                    href="/workspaces/<%= item.id %>"
                    title="<%= item.name %>">
                    <span class="d-block text-truncate"><%= item.name %></span>
                  </a>
                </li>
              <% }) %>
            <% } else { %>
              <li><span class="dropdown-item-text text-muted">No recent workspaces</span></li>
            <% } %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <a class="dropdown-item fw-semibold" href="/workspaces">View all</a>
            </li>
          </ul>
        </div>
      <% } %>

      <div class="d-flex gap-2 align-items-center">
        <% if (currentUser) { %>
          <% if (hasWorkspaceContext) { %>
            <button
              type="button"
              class="btn btn-outline-secondary btn-sm"
              data-bs-toggle="modal"
              data-bs-target="#embedScriptModal"
              aria-label="Open script tag modal"
              title="Embeddable script tag"
            >
              <i class="bi bi-code-slash"></i>
            </button>
          <% } else { %>
            <div class="dropdown">
              <button
                class="btn btn-outline-primary btn-sm dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                Profile
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/auth/profile">Profile settings</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <form action="/auth/logout" method="POST">
                    <button class="dropdown-item text-danger">Logout</button>
                  </form>
                </li>
              </ul>
            </div>
          <% } %>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary btn-sm">Login with Auth0</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<% if (currentUser && hasWorkspaceContext) { %>
  <div class="modal fade" id="embedScriptModal" tabindex="-1" aria-labelledby="embedScriptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="embedScriptModalLabel">Embeddable script tag</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="small text-muted mb-2">Copy and paste this snippet into your site.</p>
          <textarea id="navbar-embed-script" class="form-control small" rows="4" readonly><script src="<%= appUrl ? `${appUrl}/public/lib/embed.js` : '/public/lib/embed.js' %>" data-api-key="<%= workspace.apiKey %>"></script></textarea>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-primary btn-sm"
            onclick="navigator.clipboard.writeText(document.getElementById('navbar-embed-script').value)"
          >
            Copy script tag
          </button>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
<% } %>
