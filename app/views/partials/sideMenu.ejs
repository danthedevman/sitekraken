<aside class="app-sidebar d-none d-md-flex flex-column" id="workspace-sidebar">
  <div class="app-sidebar-inner d-flex flex-column h-100">
    <div class="sidebar-header d-flex align-items-center justify-content-between px-2 pt-2 pb-2 mb-2">
      <a class="sidebar-logo d-flex align-items-center gap-2 text-decoration-none" href="/workspaces">
        <span class="sidebar-logo-mark"><i class="bi bi-hurricane"></i></span>
        <span class="sidebar-logo-text fw-bold">SiteKraken</span>
      </a>
      <button
        type="button"
        class="btn btn-sm app-sidebar-toggle"
        id="sidebar-toggle-btn"
        aria-label="Toggle sidebar"
        title="Collapse sidebar"
      >
        <i class="bi bi-layout-sidebar-inset"></i>
      </button>
    </div>

    <div class="app-sidebar-body flex-grow-1 overflow-auto">
      <nav class="nav flex-column px-0 pb-3">
        <a href="/workspaces/<%= workspace._id %>/analytics" class="nav-link app-side-link<%= active === 'analytics' ? ' active' : '' %>">
          <i class="bi bi-graph-up-arrow app-side-link-icon"></i><span class="app-side-link-text">Analytics</span>
        </a>
        <a href="/workspaces/<%= workspace._id %>/announcements" class="nav-link app-side-link<%= active === 'announcements' ? ' active' : '' %>">
          <i class="bi bi-megaphone app-side-link-icon"></i><span class="app-side-link-text">Banners</span>
        </a>
        <a href="/workspaces/<%= workspace._id %>/chatbot" class="nav-link app-side-link<%= active === 'chatbot' ? ' active' : '' %>">
          <i class="bi bi-robot app-side-link-icon"></i><span class="app-side-link-text">Chatbot</span>
        </a>
        <a href="/workspaces/<%= workspace._id %>/feedback" class="nav-link app-side-link<%= active === 'feedback' ? ' active' : '' %>">
          <i class="bi bi-chat-square-dots app-side-link-icon"></i><span class="app-side-link-text">Feedback</span>
        </a>
        <a href="/workspaces/<%= workspace._id %>/logs" class="nav-link app-side-link<%= active === 'logs' ? ' active' : '' %>">
          <i class="bi bi-journal-text app-side-link-icon"></i><span class="app-side-link-text">Logs</span>
        </a>
      </nav>
    </div>

    <% if (currentUser) { %>
      <div class="sidebar-profile mt-auto px-2 py-2 border-top">
        <div class="dropdown w-100">
          <button
            class="btn app-profile-menu-toggle w-100 text-start"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="<%= currentUser.displayName || currentUser.email || 'Profile' %>">
            <span class="d-flex align-items-center gap-2 text-truncate profile-name-wrapper">
              <i class="bi bi-person-circle app-side-link-icon"></i>
              <span class="d-block text-truncate app-side-link-text"><%= currentUser.displayName || currentUser.email %></span>
            </span>
            <span class="bi bi-chevron-up sidebar-expand-icon"></span>
          </button>
          <ul class="dropdown-menu w-100 shadow-sm mb-2">
            <li><a class="dropdown-item" href="/auth/profile">Profile</a></li>
            <li><a class="dropdown-item" href="/workspaces/<%= workspace._id %>/settings">Settings</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <form action="/auth/logout" method="POST">
                <button class="dropdown-item text-danger">Logout</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    <% } %>
  </div>
</aside>

<script>
  (function () {
    const sidebar = document.getElementById('workspace-sidebar');
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const storageKey = 'sitekraken.sidebarCollapsed';
    if (!sidebar || !toggleBtn) return;

    const setCollapsed = (collapsed) => {
      sidebar.classList.toggle('is-collapsed', collapsed);
      document.body.classList.toggle('sidebar-collapsed', collapsed);
      toggleBtn.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
      const icon = toggleBtn.querySelector('i');
      if (icon) {
        icon.className = collapsed ? 'bi bi-layout-sidebar' : 'bi bi-layout-sidebar-inset';
      }
    };

    const savedCollapsed = localStorage.getItem(storageKey) === 'true';
    setCollapsed(savedCollapsed);

    toggleBtn.addEventListener('click', () => {
      const next = !sidebar.classList.contains('is-collapsed');
      setCollapsed(next);
      localStorage.setItem(storageKey, String(next));
    });
  })();
</script>
