<div class="card">
  <div class="card-body">
    <h1 class="h4 mb-3">Edit knowledge entry</h1>
    <form method="POST" action="/workspaces/<%= workspace._id %>/knowledge/<%= entry._id %>?_method=PUT">
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="title" class="form-control" value="<%= entry.title %>" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Body</label>
        <textarea id="markdown-editor" name="body" class="form-control" rows="12"><%= entry.body %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button name="actionType" value="draft" class="btn btn-outline-secondary">Save</button>
        <button name="actionType" value="publish" class="btn btn-primary">Save & Publish</button>
      </div>
    </form>
  </div>
</div>

<script>
  (() => {
   window.onload = ()=>{
     new SimpleMDE({ element: document.getElementById('markdown-editor'),hideIcons:["guide","image"] });
   }
  })()
</script>