<%- include('../partials/tabLinks', { workspace, activeTab: 'knowledge' }) %>
<div class="card">
  <div class="card-body">
    <h1 class="h4 mb-3">Edit knowledge entry</h1>

    <form
      id="knowledge-edit-form"
      method="POST"
      action="/workspaces/<%= workspace._id %>/chatbot/knowledge/<%= entry._id %>?_method=PUT"
    >
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="title" class="form-control" value="<%= entry.title %>" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Body</label>
        <textarea id="markdown-editor" name="body" class="form-control" rows="12"><%= entry.body %></textarea>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex gap-2">
        <button form="knowledge-edit-form" name="actionType" value="draft" class="btn btn-outline-secondary">Save</button>
        <button form="knowledge-edit-form" name="actionType" value="publish" class="btn btn-primary">Save & Publish</button>
      </div>

      <form
        method="POST"
        action="/workspaces/<%= workspace._id %>/chatbot/knowledge/<%= entry._id %>?_method=DELETE"
        onsubmit="return confirm('Delete this knowledge entry and its associated vector files?');"
      >
        <button type="submit" class="btn btn-outline-danger">Delete</button>
      </form>
    </div>
  </div>
</div>

<script>
  (() => {
    window.onload = () => {
      new SimpleMDE({
        element: document.getElementById('markdown-editor'),
        hideIcons: ['guide', 'image']
      });
    };
  })();
</script>
