<%- include('../partials/tabLinks', { workspace, activeTab: 'knowledge' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= entry.title %></h1>
  <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge" class="btn btn-light">Back</a>
</div>

<div class="card">
  <div class="card-body">
    <div class="mb-3">
      <span class="badge bg-<%= entry.status === 'published' ? 'success' : 'secondary' %>"><%= entry.status %></span>
    </div>
    <div><%- entry.body %></div>
  </div>
</div>
