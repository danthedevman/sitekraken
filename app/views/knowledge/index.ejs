<%- include('../partials/tabLinks', { workspace, activeTab: 'knowledge' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Knowledge · <%= workspace.name %></h1>
  <div class="d-flex gap-2">
    <a href="/workspaces/<%= workspace._id %>/chatbot" class="btn btn-light">Back</a>
    <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge/new" class="btn btn-primary">New entry</a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>OpenAI File</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach(entry => { %>
          <tr>
            <td><%= entry.title %></td>
            <td>
              <span class="badge bg-<%= entry.status === 'published' ? 'success' : 'secondary' %>">
                <%= entry.status %>
              </span>
            </td>
            <td><code><%= entry.openaiFileId || '-' %></code></td>
            <td class="text-end">
              <div class="d-inline-flex gap-2">
                <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge/<%= entry._id %>" class="btn btn-sm btn-outline-primary">View</a>
                <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge/<%= entry._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>

                <form
                  method="POST"
                  action="/workspaces/<%= workspace._id %>/chatbot/knowledge/<%= entry._id %>?_method=DELETE"
                  class="d-inline"
                  onsubmit="return confirm('Delete this knowledge entry and its associated vector files?');"
                >
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
