<%- include('../partials/chatbotTabLinks', { workspace, activeTab: 'knowledge', tabLinks }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Knowledge · <%= workspace.name %></h1>
  <div class="d-flex gap-2">
    <a href="/workspaces/<%= workspace._id %>/chatbot" class="btn btn-light">Back</a>
    <a href="/workspaces/<%= workspace._id %>/chatbot/knowledge/new" class="btn btn-primary">New entry</a>
  </div>
</div>

<%
  const columns = [
    { key: 'title', label: 'Title' },
    { key: 'status', label: 'Status' },
    { key: 'openaiFileId', label: 'OpenAI File' },
    { key: 'actions', label: '', sortable: false }
  ];

  const rows = entries.map((entry) => ({
    href: `/workspaces/${workspace._id}/chatbot/knowledge/${entry._id}`,
    values: {
      id: entry._id,
      title: entry.title || '',
      status: entry.status || 'draft',
      openaiFileId: entry.openaiFileId || ''
    },
    cells: {
      title: entry.title || '<span class="text-muted">(untitled)</span>',
      status: `<span class="badge bg-${entry.status === 'published' ? 'success' : 'secondary'}">${entry.status || 'draft'}</span>`,
      openaiFileId: `<code>${entry.openaiFileId || '-'}</code>`,
      actions: `
        <div class="d-inline-flex gap-2">
          <a href="/workspaces/${workspace._id}/chatbot/knowledge/${entry._id}" class="btn btn-sm btn-outline-primary">View</a>
          <a href="/workspaces/${workspace._id}/chatbot/knowledge/${entry._id}/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
          <form method="POST" action="/workspaces/${workspace._id}/chatbot/knowledge/${entry._id}?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete this knowledge entry and all associated locations?');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
        </div>
      `
    }
  }));
%>

<%- include('../partials/bootstrapTableWidget', {
  tableId: 'knowledge-table',
  columns,
  rows,
  defaultPageSize: 20,
  selectableRows: true,
  selectionValueKey: 'id',
  bulkActions: {
    delete: {
      action: `/workspaces/${workspace._id}/chatbot/knowledge/bulk-delete`,
      method: 'POST',
      inputName: 'ids',
      confirmMessage: 'Delete selected knowledge entries and all associated locations?'
    }
  }
}) %>
