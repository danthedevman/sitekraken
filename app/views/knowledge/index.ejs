<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Knowledge · <%= workspace.name %></h1>
  <div class="d-flex gap-2">
    <a href="/workspaces/<%= workspace._id %>" class="btn btn-light">Back</a>
    <a href="/workspaces/<%= workspace._id %>/knowledge/new" class="btn btn-primary">New entry</a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>OpenAI File</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach(entry => { %>
          <tr>
            <td><%= entry.title %></td>
            <td>
              <span class="badge bg-<%= entry.status === 'published' ? 'success' : 'secondary' %>">
                <%= entry.status %>
              </span>
            </td>
            <td><code><%= entry.openaiFileId || '-' %></code></td>
            <td class="text-end">
              <a href="/workspaces/<%= workspace._id %>/knowledge/<%= entry._id %>" class="btn btn-sm btn-outline-primary">View</a>
              <a href="/workspaces/<%= workspace._id %>/knowledge/<%= entry._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
