<%- include('../partials/tabLinks', { workspace, activeTab: 'knowledge' }) %>
<div class="card">
  <div class="card-body">
    <h1 class="h4 mb-3">New knowledge entry</h1>
    <form method="POST" action="/workspaces/<%= workspace._id %>/chatbot/knowledge">
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="title" class="form-control" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Body</label>
        <textarea id="markdown-editor" name="body" class="form-control" rows="12"></textarea>
      </div>
      <div class="d-flex gap-2">
        <button name="actionType" value="draft" class="btn btn-outline-secondary">Save Draft</button>
        <button name="actionType" value="publish" class="btn btn-primary">Publish</button>
      </div>
    </form>
  </div>
</div>

<script>
  (() => {
   window.onload = ()=>{
     new SimpleMDE({ element: document.getElementById('markdown-editor'),hideIcons:["guide","image"] });
   }
  })()
</script>
