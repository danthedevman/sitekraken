<%- include('../partials/tabLinks', { workspace, activeTab: 'analytics' }) %>
<%- include('../partials/analyticsTabLinks', { workspace, analyticsTab: 'installation' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Analytics installation · <%= workspace.name %></h1>
  <span class="badge <%= workspace.analytics?.enabled ? 'text-bg-success' : 'text-bg-secondary' %>">
    <%= workspace.analytics?.enabled ? 'Active' : 'Inactive' %>
  </span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <p class="mb-2">
      Paste this analytics tag before <code>&lt;/body&gt;</code> on your site.
      When analytics is <strong>active</strong>, events will be collected automatically.
    </p>
    <pre class="bg-dark text-light rounded p-3 mb-2"><code><%= analyticsScriptTag %></code></pre>

    <form method="POST" action="/workspaces/<%= workspace._id %>/analytics/toggle-enabled" class="mt-3">
      <input type="hidden" name="enabled" value="<%= workspace.analytics?.enabled ? 'false' : 'true' %>" />
      <button class="btn <%= workspace.analytics?.enabled ? 'btn-outline-danger' : 'btn-success' %>">
        <%= workspace.analytics?.enabled ? 'Inactivate analytics' : 'Activate analytics' %>
      </button>
    </form>
  </div>
</div>

<div class="alert alert-info mb-0" role="alert">
  Keep your workspace allowed domains up to date; analytics events are accepted only from approved origins.
</div>
