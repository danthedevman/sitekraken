<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="badge text-bg-light border"><%= dateRangeLabel %></span>
</div>

<div class="card mb-3">
  <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
      <div class="small text-muted">Analytics status</div>
      <div class="fw-semibold"><%= workspace.analytics?.enabled ? 'Active' : 'Inactive' %></div>
    </div>

    <form method="POST" action="/workspaces/<%= workspace._id %>/analytics/toggle-enabled" class="m-0">
      <input type="hidden" name="enabled" value="<%= workspace.analytics?.enabled ? 'false' : 'true' %>" />
      <button class="btn <%= workspace.analytics?.enabled ? 'btn-outline-danger' : 'btn-success' %>">
        <%= workspace.analytics?.enabled ? 'Inactivate analytics' : 'Activate analytics' %>
      </button>
    </form>
  </div>
</div>

<div class="row g-3 mb-2">
  <% scorecards.forEach((card) => { %>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small"><%= card.label %></div>
          <div class="display-6 fw-semibold"><%= card.displayValue || card.value.toLocaleString() %></div>
          <div class="small text-secondary"><%= card.helper %></div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="row g-3 mt-1">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><strong>Click breakdown</strong></div>
      <div class="card-body p-0">
        <% if (!clickBreakdown.length) { %>
          <div class="p-3 text-muted">No click activity recorded yet.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Type</th>
                  <th class="text-end">Events</th>
                  <th class="text-end">Share</th>
                </tr>
              </thead>
              <tbody>
                <% clickBreakdown.forEach((row) => { %>
                  <tr>
                    <td><code><%= row.label %></code></td>
                    <td class="text-end"><%= row.count %></td>
                    <td class="text-end"><%= row.percentage %>%</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><strong>Top pages</strong></div>
      <div class="card-body p-0">
        <% if (!topPages.length) { %>
          <div class="p-3 text-muted">No page views yet.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Path</th>
                  <th class="text-end">Views</th>
                </tr>
              </thead>
              <tbody>
                <% topPages.forEach((row) => { %>
                  <tr>
                    <td><code><%= row.pathname %></code></td>
                    <td class="text-end"><%= row.views %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><strong>Top link clicks</strong></div>
      <div class="card-body p-0">
        <% if (!topLinks.length) { %>
          <div class="p-3 text-muted">No link clicks recorded.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Href</th>
                  <th class="text-end">Clicks</th>
                </tr>
              </thead>
              <tbody>
                <% topLinks.forEach((row) => { %>
                  <tr>
                    <td class="text-break"><%= row.href %></td>
                    <td class="text-end"><%= row.count %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><strong>Top button clicks</strong></div>
      <div class="card-body p-0">
        <% if (!topButtons.length) { %>
          <div class="p-3 text-muted">No button clicks recorded.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Button</th>
                  <th class="text-end">Clicks</th>
                </tr>
              </thead>
              <tbody>
                <% topButtons.forEach((row) => { %>
                  <tr>
                    <td><%= row.label %></td>
                    <td class="text-end"><%= row.count %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><strong>Daily event timeline</strong></div>
  <div class="card-body p-0">
    <% if (!eventTimeline.length) { %>
      <div class="p-3 text-muted">No analytics events available for this range.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Event type</th>
              <th class="text-end">Count</th>
            </tr>
          </thead>
          <tbody>
            <% eventTimeline.forEach((row) => { %>
              <tr>
                <td><%= row._id.day %></td>
                <td><code><%= row._id.type %></code></td>
                <td class="text-end"><%= row.count %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
