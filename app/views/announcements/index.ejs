<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="m-0">Banners</h4>
    <div class="text-muted small">Manage announcement banners for <%= workspace.name %>.</div>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge <%= banners?.enabled ? 'text-bg-success' : 'text-bg-secondary' %>">
      <%= banners?.enabled ? 'Enabled' : 'Disabled' %>
    </span>
    <a class="btn btn-primary btn-sm" href="/workspaces/<%= workspace._id %>/announcements/new">New banner</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="POST" action="/workspaces/<%= workspace._id %>/announcements" class="row g-3 align-items-end">
      <input type="hidden" name="intent" value="settings" />
      <div class="col-12 col-md-6 form-check form-switch">
        <input class="form-check-input" type="checkbox" id="enabled" name="enabled" <%= banners?.enabled ? 'checked' : '' %> />
        <label class="form-check-label" for="enabled">Enable banner library</label>
      </div>
      <div class="col-12 col-md-6 text-md-end">
        <button class="btn btn-outline-primary">Save library settings</button>
      </div>
    </form>
  </div>
</div>

<%
  const columns = [
    { key: 'title', label: 'Title' },
    { key: 'message', label: 'Message' },
    { key: 'status', label: 'Status' },
    { key: 'type', label: 'Type' },
    { key: 'schedule', label: 'Schedule' }
  ];

  const rows = items.map((item) => ({
    href: `/workspaces/${workspace._id}/announcements/${item.id}/edit`,
    values: {
      id: item.id,
      title: item.title || '',
      message: item.message || '',
      status: item.status || 'draft',
      type: item.type || 'top',
      scheduleStartAt: item.scheduleStartAt || '',
      scheduleEndAt: item.scheduleEndAt || ''
    },
    cells: {
      title: `<div class="fw-semibold">${item.title || 'Untitled'}</div>`,
      message: `<div class="small text-muted text-truncate" style="max-width: 420px;" title="${(item.message || '').replaceAll('"', '&quot;')}">${item.message || 'No message'}</div>`,
      status: `<span class="badge text-bg-${item.status === 'published' ? 'success' : item.status === 'scheduled' ? 'warning' : 'secondary'}">${item.status}</span>`,
      type: item.type,
      schedule: `<div class="small"><div>${item.scheduleStartAt ? new Date(item.scheduleStartAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : '—'}</div><div>${item.scheduleEndAt ? new Date(item.scheduleEndAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : '—'}</div></div>`
    }
  }));
%>

<%- include('../partials/bootstrapTableWidget', {
  tableId: 'banners-table',
  columns,
  rows,
  defaultPageSize: tableState.pageSize,
  selectableRows: true,
  selectionValueKey: 'id',
  bulkActions: {
    delete: {
      action: `/workspaces/${workspace._id}/announcements/bulk-delete`,
      method: 'POST',
      inputName: 'ids',
      confirmMessage: 'Delete selected banners?'
    }
  },
  serverPagination: {
    page: tableState.page,
    totalPages: tableState.totalPages,
    totalRows: tableState.totalRows,
    search: tableState.search,
    pageSize: tableState.pageSize,
    sort: tableState.sort,
    direction: tableState.direction
  }
}) %>
