<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SiteKraken</title>
    <script>
      (function () {
        const savedTheme = localStorage.getItem('sitekraken.theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
      })();
    </script>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/public/css/app.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <% if (typeof workspace !== 'undefined' && workspace) { %>
      <%- include('partials/sideMenu', { workspace, active: (typeof active !== 'undefined' && active) ? active : 'dashboard' }) %>
    <% } %>

    <main class="app-main <%= (typeof workspace !== 'undefined' && workspace) ? 'with-sidebar' : '' %>">
      <div class="container-fluid py-4">
        <%- include('partials/flash') %>
        <%- body %>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
