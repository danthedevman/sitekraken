<div class="p-5 mb-4 bg-light rounded-3 border">
  <div class="container-fluid py-5">
    <h1 class="display-6 fw-bold">Workspace + OpenAI file manager</h1>
    <p class="col-md-9 fs-5">
      Create workspaces, upload files to OpenAI storage, publish markdown knowledge into your vector store,
      manage chatbot configuration, control allowed domains, and copy an embed script tag with a workspace API key.
    </p>

    <% if (!currentUser) { %>
      <a href="/auth/login" class="btn btn-primary btn-lg">Get started</a>
    <% } else { %>
      <a href="/workspaces" class="btn btn-primary btn-lg">Open dashboard</a>
    <% } %>
  </div>
</div>
