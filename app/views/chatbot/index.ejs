<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Chatbot config · <%= workspace.name %></h1>
  <a href="/workspaces/<%= workspace._id %>" class="btn btn-light">Back</a>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <form method="POST" action="/workspaces/<%= workspace._id %>/chatbot">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Name</label>
              <input name="name" class="form-control" value="<%= chatbot.name %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Script URL</label>
              <input name="scriptUrl" class="form-control" value="<%= chatbot.scriptUrl %>" />
            </div>

            <div class="col-md-6">
              <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="enabled" <%= chatbot.enabled ? 'checked' : '' %> />
                <label class="form-check-label">Enabled</label>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="module" <%= chatbot.module ? 'checked' : '' %> />
                <label class="form-check-label">Module</label>
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Title</label>
              <input name="title" class="form-control" value="<%= chatbot.config.title %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Subtitle</label>
              <input name="subtitle" class="form-control" value="<%= chatbot.config.subtitle %>" />
            </div>

            <div class="col-12">
              <label class="form-label">Initial Message</label>
              <textarea name="initialMessage" class="form-control" rows="4"><%= chatbot.config.initialMessage %></textarea>
            </div>

            <div class="col-md-6">
              <label class="form-label">Quick Messages (one per line)</label>
              <textarea name="quickMessages" class="form-control" rows="8"><%= chatbot.config.quickMessages.join('') %></textarea>
            </div>

            <div class="col-md-6">
              <label class="form-label">Footer Links (Label|Href per line)</label>
              <textarea name="footerLinks" class="form-control" rows="8"><%= chatbot.config.footerLinks.map(link => `${link.label}|${link.href}`).join('') %></textarea>
            </div>

            <div class="col-12">
              <label class="form-label">Allowed Domains (one per line)</label>
              <textarea name="allowedDomains" class="form-control" rows="5" placeholder="example.com&#10;jobs.example.com"><%= (chatbot.allowedDomains || []).join('') %></textarea>
              <div class="form-text">Store bare hostnames only. Example: <code>example.com</code></div>
            </div>
          </div>

          <button class="btn btn-primary mt-3">Save config</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3 border-info">
      <div class="card-body">
        <h2 class="h5">Embed API key</h2>
        <p class="small text-muted mb-2">This key is generated per workspace.</p>
        <div class="bg-light border rounded p-2 small"><code><%= chatbot.apiKey %></code></div>

        <form class="mt-3" method="POST" action="/workspaces/<%= workspace._id %>/chatbot/regenerate-key">
          <button class="btn btn-outline-warning btn-sm">Regenerate API key</button>
        </form>
      </div>
    </div>

    <div class="card mb-3 border-success">
      <div class="card-body">
        <h2 class="h5">Script tag</h2>
        <p class="small text-muted">Copy and paste this into the target site.</p>
        <textarea id="embed-script" class="form-control small" rows="5" readonly><%= embedScriptTag %></textarea>
        <button type="button" class="btn btn-success btn-sm mt-2" onclick="navigator.clipboard.writeText(document.getElementById('embed-script').value)">Copy script tag</button>
      </div>
    </div>

    <div class="card border-info">
      <div class="card-body">
        <h2 class="h5">Current JSON</h2>
<pre class="mb-0"><code><%= JSON.stringify({
  name: chatbot.name,
  enabled: chatbot.enabled,
  scriptUrl: chatbot.scriptUrl,
  module: chatbot.module,
  allowedDomains: chatbot.allowedDomains || [],
  apiKey: chatbot.apiKey,
  config: chatbot.config
}, null, 2) %></code></pre>
      </div>
    </div>
  </div>
</div>
